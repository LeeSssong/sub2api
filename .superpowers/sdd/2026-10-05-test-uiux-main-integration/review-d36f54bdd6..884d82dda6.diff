diff --git a/prototype/dialogs.mjs b/prototype/dialogs.mjs
new file mode 100644
index 0000000000..a0fd6b0ae0
--- /dev/null
+++ b/prototype/dialogs.mjs
@@ -0,0 +1,51 @@
+import * as M from './model.mjs';
+import {esc,money,rmb,date,routeIdentity,btn,iconBtn,select,field,empty,errorBox,formActions,showModal,closeModal,formError,toast,copy,table} from './ui.mjs';
+import {keyHeaders,usageHeaders,usageErrorHeaders} from './pages.mjs';
+import {defaultHiddenKeyColumns} from './key-columns.mjs';
+const at=id=>`data-id="${esc(id)}"`;
+const input=(name,value='',attrs='')=>`<input name="${name}" value="${esc(value)}" ${attrs}>`;
+const toggle=(id,label,checked,body)=>`<label class="toggle-row"><span>${label}</span><input type="checkbox" class="switch" name="${id}" ${checked?'checked':''} data-toggle="${id}-detail"></label><div class="toggle-detail" id="${id}-detail" ${checked?'':'hidden'}>${body}</div>`;
+export const routeChoice=r=>routeIdentity(r,'route-choice-identity');
+const keyOption=(id,label,checked,body)=>`<div class="key-option">${toggle(id,label,checked,body)}</div>`;
+export function keyFormContent(c,{tool='',id='',routeId=''}={}){
+ const k=id?c.state.keys.find(key=>key.id===id):null;
+ const routes=c.state.routes.filter(r=>(r.enabled||r.id===k?.routeId)&&(!tool||r.tool===tool));
+ const selected=k?.routeId||routeId,route=c.state.routes.find(r=>r.id===selected);
+ const nameField=field('名称',input('name',k?.name||'','placeholder="我的 API 密钥" maxlength="50" required'));
+ const routeField=`<div class="field route-select"><label class="label" id="route-label">线路</label><input type="hidden" name="routeId" value="${esc(selected)}"><button type="button" class="select-trigger" data-action="route-dropdown" aria-labelledby="route-label route-value" aria-expanded="false" aria-required="true"><span id="route-value">${routeChoice(route)}</span><span aria-hidden="true">⌄</span></button><span class="field-error" id="route-error" role="alert"></span><div id="route-options" class="route-options" hidden><input type="search" placeholder="搜索${tool?'当前工具':''}线路" aria-label="搜索线路" data-input="route-search"><div id="route-option-list">${routeOptions(c,routes,selected)}</div></div></div>`;
+ const ipFields=field('IP 白名单',`<textarea name="ipWhitelist" rows="2" placeholder="每行一个 IP 或网段">${esc(k?.ipWhitelist||'')}</textarea>`)+field('IP 黑名单',`<textarea name="ipBlacklist" rows="2" placeholder="每行一个 IP 或网段">${esc(k?.ipBlacklist||'')}</textarea>`);
+ const rateFields=[['rate5h','5 小时额度'],['rate1d','1 天额度'],['rate7d','7 天额度']].map(([name,label])=>field(label,input(name,k?.[name]||0,'type="number" min="0" step="0.01"'))).join('');
+ const expiry=`<div class="expiry-presets">${[7,30,90].map(days=>btn(`${days} 天`,'key-expires-preset','small',`data-days="${days}"`)).join('')}</div>${input('expires',k?.expires||'','type="date"')}`;
+ return `<form id="key-form" class="compact-key-form"><div class="modal-body"><div class="key-form-stack">${nameField}${routeField}</div><div class="key-settings-stack">${k?'':keyOption('customOn','自定义密钥',false,input('custom','','placeholder="8–100 位字母、数字、下划线或横线" autocomplete="off"'))}${keyOption('ipOn','IP 限制',!!(k?.ipWhitelist||k?.ipBlacklist),ipFields)}<div class="key-limit-option">${field('额度限制',input('limit',k?.limit??0,'type="number" min="0" step="0.01" placeholder="输入 USD 额度限制"'),'设置此密钥可消费的最大金额。0 = 无限制。')}</div>${keyOption('rateOn','速率限制',!!(k?.rate5h||k?.rate1d||k?.rate7d),rateFields)}${keyOption('expiresOn','密钥有效期',!!k?.expires,expiry)}</div>${errorBox()}</div>${formActions(k?'保存':'创建')}</form>`;
+}
+export function openKey(c,options={}){const {tool='',id='',returnTo=null}=options;c.modal={type:'key',id,tool,returnTo};showModal(id?'编辑密钥':tool?'创建线路密钥':'创建密钥',keyFormContent(c,options));document.querySelector('#modal')?.classList.add('key-form-modal');}
