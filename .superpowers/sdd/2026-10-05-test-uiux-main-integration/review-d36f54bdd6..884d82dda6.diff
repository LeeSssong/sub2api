+        [[ "${REDISCLI_AUTH:-}" == fixture-secret ]] || exit 47
+        [[ "$mode" != redis-save-fail ]] || exit 42
+        if [[ "$mode" == redis-auth-rejected ]]; then printf 'NOAUTH Authentication required.\n'; else printf 'OK\n'; fi
+      else
+        exit 65
+      fi
+      ;;
