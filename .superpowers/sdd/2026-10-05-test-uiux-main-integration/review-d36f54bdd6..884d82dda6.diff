+      if [[ "$*" == *'redis-cli --no-auth-warning -a "$REDIS_PASSWORD" SAVE'* ]]; then
+        exit 47
+      elif [[ "$*" == *'redis-check-rdb /tmp/sub2api-test-station-redis.rdb'* ]]; then
+        [[ "$mode" != redis-rdb-corrupt ]] || exit 46
