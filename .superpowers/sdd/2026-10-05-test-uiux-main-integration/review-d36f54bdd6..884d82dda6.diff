+func TestMonitorV4TimelineBuckets(t *testing.T) {
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	defer db.Close()
+	r := &accountMonitorRepository{db: db}
+	end := time.Date(2026, 10, 5, 12, 0, 0, 0, time.UTC)
