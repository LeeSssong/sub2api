+    if(path==='/api/v1/payment/orders/my') return json(ok({items:[],total:0,page:1,page_size:20}));
+    if(path==='/api/v1/redeem/history') return json(ok([]));
+    if(path==='/api/v1/user/profile') return json(ok(user));
+    if(path==='/api/v1/user/passkeys') return json(ok([]));
+    if(path==='/api/v1/user/totp/status') return json(ok({enabled:false}));
+    return json(ok({}));
+  };
+  const NativeXHR=window.XMLHttpRequest;
+  window.XMLHttpRequest=function(){const x=new NativeXHR();let method='GET',url='';const open=x.open.bind(x),send=x.send.bind(x);x.open=function(m,u){method=m;url=u;return open(...arguments)};x.send=function(body){const path=new URL(url,location.origin).pathname;if(path.startsWith('/api/v1')){const data=mockResponse(path,url,{method,body});Object.defineProperty(x,'status',{value:200});Object.defineProperty(x,'statusText',{value:'OK'});Object.defineProperty(x,'readyState',{value:4});Object.defineProperty(x,'responseText',{value:JSON.stringify(data)});Object.defineProperty(x,'response',{value:JSON.stringify(data)});x.getAllResponseHeaders=()=> 'content-type: application/json\r\n';queueMicrotask(()=>{x.onreadystatechange?.();x.onload?.();x.onloadend?.();});return}return send(body)};return x};
