{
	auto_https disable_redirects
}

cpa-test.xingqiaolab.top {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode zstd gzip
	redir / /management.html 302
	handle /v1/* {
		reverse_proxy cpa-gateway:8317 {
			transport http {
				dial_timeout 5s
				response_header_timeout 2m
			}
		}
	}
	handle /v0/resource/plugins/cliproxy-ticket-gateway/ui {
		root * /etc/caddy
		rewrite * /ticket-gateway-ui.html
		header Cache-Control "no-store"
		file_server
	}
	handle {
		reverse_proxy cpa-manager:18317 {
			transport http {
				dial_timeout 5s
				response_header_timeout 2m
			}
		}
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
