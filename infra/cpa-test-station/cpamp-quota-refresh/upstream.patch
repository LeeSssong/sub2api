+import { act, create, type ReactTestRenderer } from 'react-test-renderer';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { useAccountQuotaAutoRefresh } from './useAccountQuotaAutoRefresh';
+const a = { selectionKey: 'a', provider: 'codex', runtimeOnly: false };
+const b = { ...a, selectionKey: 'b' };
+let renderer: ReactTestRenderer;
+let visibility = 'visible';
+const refresh = vi.fn(async () => ({ status: 'success' }));
+function Harness({ rows = [a], enabled = true, scope = 'test' }) {
+  const state = useAccountQuotaAutoRefresh(rows, enabled, scope, refresh);
+  return <span>{JSON.stringify(state.failures)}</span>;
+}
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(1000);
+  refresh.mockReset();
+  refresh.mockResolvedValue({ status: 'success' });
+  visibility = 'visible';
+  vi.stubGlobal('document', {
+    get visibilityState() {
+      return visibility;
+    },
+    addEventListener: vi.fn(),
+    removeEventListener: vi.fn(),
+  });
+});
+afterEach(async () => {
+  if (renderer) await act(async () => renderer.unmount());
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+describe('account quota background refresh', () => {
+  it('starts asynchronously and refreshes only visible Codex rows at five minutes', async () => {
+    await act(async () => {
+      renderer = create(<Harness rows={[a, { ...b, provider: 'claude' }]} />);
+    });
+    expect(refresh).not.toHaveBeenCalled();
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(0);
+    });
+    expect(refresh).toHaveBeenCalledTimes(1);
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(299999);
+    });
+    expect(refresh).toHaveBeenCalledTimes(1);
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(1);
+    });
+    expect(refresh).toHaveBeenCalledTimes(2);
+  });
+  it('marks failure, waits for the next cycle and clears it after recovery', async () => {
+    refresh.mockRejectedValueOnce(new Error('quota service unavailable'));
+    await act(async () => {
+      renderer = create(<Harness />);
+      await vi.advanceTimersByTimeAsync(0);
+    });
+    // Effects are installed after the first render.
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(0);
+    });
+    expect(renderer.root.findByType('span').children[0]).toContain('1000');
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(299999);
+    });
+    expect(refresh).toHaveBeenCalledTimes(1);
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(1);
+    });
+    expect(renderer.root.findByType('span').children[0]).toBe('{"a":0}');
+  });
+  it('preserves cadence across row changes and skips hidden or disconnected pages', async () => {
+    await act(async () => {
+      renderer = create(<Harness />);
+    });
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(0);
+    });
+    await act(async () => {
+      renderer.update(<Harness rows={[a, b]} />);
+    });
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(0);
+    });
+    expect(
+      refresh.mock.calls.map((call) => (call as unknown as [typeof a])[0].selectionKey)
+    ).toEqual(['a', 'b']);
+    visibility = 'hidden';
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(300000);
+    });
+    expect(refresh).toHaveBeenCalledTimes(2);
+    visibility = 'visible';
+    await act(async () => {
+      renderer.update(<Harness enabled={false} />);
+    });
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(300000);
+    });
+    expect(refresh).toHaveBeenCalledTimes(2);
+  });
+});
