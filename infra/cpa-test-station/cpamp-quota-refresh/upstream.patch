@@ -0,0 +1,54 @@
+import { describe, it, expect, vi } from 'vitest';
+import { createQuotaAutoRefresh, QUOTA_REFRESH_MS } from './quotaAutoRefresh';
+
+describe('display-only quota refresh', () => {
+  it('refreshes once, serializes concurrent ticks, and waits five minutes even after failure', async () => {
+    let finish!: () => void;
+    const refresh = vi.fn(
+      () =>
+        new Promise<void>((resolve) => {
+          finish = resolve;
+        })
+    );
+    const poller = createQuotaAutoRefresh<string>();
+    const first = poller.tick(['a'], (x) => x, refresh, 1000);
+    await poller.tick(['a'], (x) => x, refresh, 2000);
+    expect(refresh).toHaveBeenCalledTimes(1);
+    finish();
+    await first;
+    await poller.tick(['a'], (x) => x, refresh, 1000 + QUOTA_REFRESH_MS - 1);
+    expect(refresh).toHaveBeenCalledTimes(1);
+    refresh.mockImplementation(async () => {
+      throw new Error('offline');
+    });
+    await expect(
+      poller.tick(['a'], (x) => x, refresh, 1000 + QUOTA_REFRESH_MS)
+    ).resolves.toBeUndefined();
+    expect(refresh).toHaveBeenCalledTimes(2);
+    await poller.tick(['a'], (x) => x, refresh, 1001 + QUOTA_REFRESH_MS);
+    expect(refresh).toHaveBeenCalledTimes(2);
+  });
+  it('queries distinct accounts serially and stops on dispose', async () => {
+    const poller = createQuotaAutoRefresh<string>();
+    const seen: string[] = [];
+    await poller.tick(
+      ['a', 'a', 'b', 'c'],
+      (x) => x,
+      async (x) => {
+        seen.push(x);
+        if (x === 'b') poller.dispose();
+      },
+      1000
+    );
+    expect(seen).toEqual(['a', 'b']);
+    await poller.tick(
+      ['d'],
+      (x) => x,
+      async (x) => {
+        seen.push(x);
+      },
+      999999
+    );
+    expect(seen).toEqual(['a', 'b']);
+  });
+});
