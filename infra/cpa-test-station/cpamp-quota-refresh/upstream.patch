+++ b/apps/web/src/features/accounts/hooks/useAccountQuotaAutoRefresh.ts
@@ -0,0 +1,76 @@
+import { useEffect, useRef, useState } from 'react';
+import { createQuotaAutoRefresh } from '../model/quotaAutoRefresh';
+
+type Row = { selectionKey: string; provider: string; runtimeOnly: boolean };
+type Outcome = { status: string };
+export function useAccountQuotaAutoRefresh<T extends Row>(
+  rows: T[],
+  enabled: boolean,
+  scope: string,
+  refresh: (row: T) => Promise<Outcome>
+) {
+  const latest = useRef({ rows, refresh });
+  latest.current = { rows, refresh };
+  const tickRef = useRef<() => void>(() => {});
+  const [state, setState] = useState<{
+    scope: string;
+    now: number;
+    failures: Record<string, number>;
+  }>({ scope, now: Date.now(), failures: {} });
+  const keys = rows
+    .filter((row) => row.provider === 'codex' && !row.runtimeOnly)
+    .map((row) => row.selectionKey)
+    .join('\n');
+  useEffect(() => {
+    if (!enabled) return;
+    let active = true;
+    const poller = createQuotaAutoRefresh<T>();
+    const tick = () => {
+      if (document.visibilityState === 'hidden') return;
+      setState((previous) => ({
+        scope,
+        now: Date.now(),
+        failures: previous.scope === scope ? previous.failures : {},
+      }));
+      void poller.tick(
+        latest.current.rows.filter((row) => row.provider === 'codex' && !row.runtimeOnly),
+        (row) => row.selectionKey,
+        async (row) => {
+          let failed = false;
+          try {
+            failed = (await latest.current.refresh(row)).status === 'error';
+          } catch {
+            failed = true;
+          }
+          if (!active) return;
+          setState((previous) => ({
+            scope,
+            now: Date.now(),
+            failures: {
+              ...(previous.scope === scope ? previous.failures : {}),
+              [row.selectionKey]: failed ? Date.now() : 0,
+            },
+          }));
+        },
+        Date.now()
+      );
+    };
+    tickRef.current = tick;
+    const initial = setTimeout(tick, 0);
+    const interval = setInterval(tick, 30_000);
+    document.addEventListener('visibilitychange', tick);
+    return () => {
+      tickRef.current = () => {};
+      active = false;
+      poller.dispose();
+      clearTimeout(initial);
+      clearInterval(interval);
+      document.removeEventListener('visibilitychange', tick);
+    };
+  }, [enabled, scope]);
+  useEffect(() => {
+    const timer = setTimeout(() => tickRef.current(), 0);
+    return () => clearTimeout(timer);
+  }, [keys]);
+  return state.scope === scope ? state : { scope, now: Date.now(), failures: {} };
+}
