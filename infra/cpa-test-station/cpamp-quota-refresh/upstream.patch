index 0000000..0a73142
--- /dev/null
+++ b/apps/web/src/features/accounts/model/quotaAutoRefresh.ts
@@ -0,0 +1,38 @@
+export const QUOTA_REFRESH_MS = 5 * 60 * 1000;
+
+// Display-only work: bounded to one outstanding request, no retry loop.
+export function createQuotaAutoRefresh<T>() {
+  const attempted = new Map<string, number>();
+  let busy = false;
+  let disposed = false;
+  return {
+    dispose() {
+      disposed = true;
+    },
+    async tick(
+      items: T[],
+      keyOf: (item: T) => string,
+      refresh: (item: T) => Promise<unknown>,
+      now: number
+    ) {
+      if (busy || disposed) return;
+      busy = true;
+      try {
+        for (const item of items) {
+          if (disposed) break;
+          const key = keyOf(item);
+          const previous = attempted.get(key);
+          if (previous !== undefined && now - previous < QUOTA_REFRESH_MS) continue;
+          attempted.set(key, now);
+          try {
+            await refresh(item);
+          } catch {
+            /* Next scheduled attempt only. */
+          }
+        }
+      } finally {
+        busy = false;
+      }
+    },
+  };
+}
